<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><AssemblyName>BepInExLogAlerts</AssemblyName><RootNamespace>BepInExLogAlerts</RootNamespace>
    <Version>0.1.6</Version><AssemblyVersion>0.1.6.0</AssemblyVersion><FindDependenciesOfExternallyResolvedReferences>false</FindDependenciesOfExternallyResolvedReferences>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AnchorChain" HintPath="$(AnchorChainDir)\AnchorChain.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="BepInEx" HintPath="$(SeaPowerDir)\BepInEx\core\BepInEx.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\UnityEngine.CoreModule.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\UnityEngine.IMGUIModule.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\UnityEngine.TextRenderingModule.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="Unity.InputSystem" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\Unity.InputSystem.dll" Private="false" ExternallyResolved="true" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AnchorChainDir)\AnchorChain.dll')" Text="Set AnchorChainDir in Directory.Build.local.props." />
    <Error Condition="!Exists('$(SeaPowerDir)\BepInEx\core\BepInEx.dll')" Text="Set SeaPowerDir in Directory.Build.local.props." />
  </Target>
</Project>
